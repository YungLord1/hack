apiVersion: v1
kind: ConfigMap
metadata:
  name: logging-dashboard
  namespace: monitoring
  labels:
    grafana_dashboard: "1"
data:
  logging-dashboard.json: |
    {
      "uid": "kubernetes-logging",
      "title": "Kubernetes Logging",
      "tags": [
        "kubernetes",
        "logging",
        "loki",
        "fluentd"
      ],
      "timezone": "browser",
      "schemaVersion": 39,
      "version": 1,
      "refresh": "10s",
      "time": {
        "from": "now-1h",
        "to": "now"
      },
      "templating": {
        "list": [
          {
            "name": "DS_LOKI",
            "label": "Loki",
            "type": "datasource",
            "query": "loki",
            "refresh": 1
          }
        ]
      },
      "panels": [
        {
          "id": 1,
          "type": "stat",
          "title": "Logs / 5 min",
          "gridPos": {
            "h": 4,
            "w": 6,
            "x": 0,
            "y": 0
          },
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum(count_over_time({job=\"fluentd\"}[5m]))"
            }
          ],
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "orientation": "auto",
            "colorMode": "value",
            "graphMode": "area",
            "justifyMode": "auto"
          }
        },
        {
          "id": 2,
          "type": "stat",
          "title": "HTTP 2xx / 5 min",
          "gridPos": {
            "h": 4,
            "w": 6,
            "x": 6,
            "y": 0
          },
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum(count_over_time({job=\"fluentd\"} |= \"HTTP/1.1\" | regexp `.*\\\" (?P<status>[0-9]{3}) [0-9]+ .*` | status=~\"2..\" [5m]))"
            }
          ],
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "orientation": "auto",
            "colorMode": "value",
            "graphMode": "area",
            "justifyMode": "auto"
          }
        },
        {
          "id": 3,
          "type": "stat",
          "title": "HTTP 4xx / 5 min",
          "gridPos": {
            "h": 4,
            "w": 6,
            "x": 12,
            "y": 0
          },
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum(count_over_time({job=\"fluentd\"} |= \"HTTP/1.1\" | regexp `.*\\\" (?P<status>[0-9]{3}) [0-9]+ .*` | status=~\"4..\" [5m]))"
            }
          ],
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "orientation": "auto",
            "colorMode": "value",
            "graphMode": "area",
            "justifyMode": "auto"
          }
        },
        {
          "id": 4,
          "type": "stat",
          "title": "HTTP 5xx / 5 min",
          "gridPos": {
            "h": 4,
            "w": 6,
            "x": 18,
            "y": 0
          },
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum(count_over_time({job=\"fluentd\"} |= \"HTTP/1.1\" | regexp `.*\\\" (?P<status>[0-9]{3}) [0-9]+ .*` | status=~\"5..\" [5m]))"
            }
          ],
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "orientation": "auto",
            "colorMode": "value",
            "graphMode": "area",
            "justifyMode": "auto"
          }
        },
        {
          "id": 5,
          "type": "timeseries",
          "title": "HTTP Responses by Status",
          "gridPos": {
            "h": 9,
            "w": 24,
            "x": 0,
            "y": 4
          },
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by (status) (count_over_time({job=\"fluentd\"} |= \"HTTP/1.1\" | regexp `.*\\\" (?P<status>[0-9]{3}) [0-9]+ .*` [5m]))",
              "legendFormat": "{{ '{{status}}' }}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "min": 0
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom"
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          }
        },
        {
          "id": 6,
          "type": "logs",
          "title": "Kubernetes Logs",
          "gridPos": {
            "h": 15,
            "w": 24,
            "x": 0,
            "y": 13
          },
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "{job=\"fluentd\"}",
              "queryType": "range"
            }
          ],
          "options": {
            "showTime": true,
            "showLabels": true,
            "showCommonLabels": false,
            "wrapLines": true,
            "prettifyLogMessage": false,
            "enableLogDetails": true,
            "sortOrder": "Descending"
          }
        }
      ]
    }
