apiVersion: v1
kind: Service
metadata:
  name: loki-nodeport
  namespace: {{ logging_namespace }}
spec:
  type: NodePort

  selector:
    app.kubernetes.io/name: loki
    app.kubernetes.io/instance: {{ loki_release_name }}

  ports:
    - name: http
      port: 3100
      targetPort: 3100
      nodePort: 30100
      protocol: TCP
